generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  image           String?
  role            String    @default("OWNER")
  agencyId        String?
  onboardingStep  Int       @default(0)
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency          Agency?   @relation(fields: [agencyId], references: [id])
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Agency {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  ownerId             String
  logoUrl             String?
  accentColor         String   @default("#6B4FE0")
  fromName            String?
  fontPair            String   @default("manrope-source-sans")
  customDomain        String?  @unique
  customDomainStatus  String   @default("pending")
  plan                String   @default("TRIAL")
  stripeCustomerId    String?
  planRenewsAt        DateTime?
  profileComplete     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users              User[]
  leads              LocalBusiness[]
  sites              Site[]
  clients            Client[]
  invoices           Invoice[]
  changeRequests     ChangeRequest[]
  domainVerifications DomainVerification[]
}

model LocalBusiness {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  category    String
  address     String
  city        String
  lat         Float
  lng         Float
  phone       String?
  email       String?
  hours       String?
  rating      Float?
  hasWebsite  Boolean  @default(false)
  source      String   @default("scan")
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  agency      Agency   @relation(fields: [agencyId], references: [id])
  site        Site?
}

model Site {
  id            String   @id @default(cuid())
  agencyId      String
  leadId        String?  @unique
  slug          String   @unique
  templateKey   String
  data          String
  brand         String
  status        String   @default("DRAFT")
  publishedAt   DateTime?
  customDomain  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id])
  lead          LocalBusiness? @relation(fields: [leadId], references: [id])
  client        Client?
}

model Client {
  id            String   @id @default(cuid())
  agencyId      String
  businessName  String
  contactName   String?
  contactEmail  String?
  siteId        String?  @unique
  mrr           Float    @default(0)
  status        String   @default("ACTIVE")
  renewalAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agency        Agency          @relation(fields: [agencyId], references: [id])
  site          Site?           @relation(fields: [siteId], references: [id])
  invoices      Invoice[]
  changeRequests ChangeRequest[]
}

model Invoice {
  id              String   @id @default(cuid())
  agencyId        String
  clientId        String?
  amount          Float
  currency        String   @default("usd")
  status          String   @default("pending")
  stripeInvoiceId String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  agency          Agency   @relation(fields: [agencyId], references: [id])
  client          Client?  @relation(fields: [clientId], references: [id])
}

model ChangeRequest {
  id          String    @id @default(cuid())
  clientId    String
  agencyId    String
  body        String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  client      Client    @relation(fields: [clientId], references: [id])
  agency      Agency    @relation(fields: [agencyId], references: [id])
}

model DomainVerification {
  id         String    @id @default(cuid())
  agencyId   String
  domain     String
  token      String
  verifiedAt DateTime?

  agency     Agency    @relation(fields: [agencyId], references: [id])
}
